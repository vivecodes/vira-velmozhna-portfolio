---
import "../styles/global.css";
import StarField from "../components/StarField.astro";
import type { Lang } from "../i18n";
import { locales, switchLocalePath } from "../i18n";
import { useTranslations } from "../i18n/ui";

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  ogTitle?: string;
  ogDescription?: string;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const title = Astro.props.title ?? t("meta.title");
const description = Astro.props.description ?? t("meta.description");
const ogTitle = Astro.props.ogTitle ?? title;
const ogDescription = Astro.props.ogDescription ?? t("meta.ogDescription");

const path = Astro.url.pathname;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, maximum-scale=5.0"
    />
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:locale" content={lang === "de" ? "de_DE" : "en_US"} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />

    {
      locales.map((locale) => (
        <link
          rel="alternate"
          hreflang={locale}
          href={switchLocalePath(path, locale)}
        />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={switchLocalePath(path, "en")} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
  </head>
  <body>
    <StarField />
    <slot />
  </body>
</html>
