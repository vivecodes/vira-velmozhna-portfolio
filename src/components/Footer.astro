---
import type { Lang } from "../i18n";
import { useTranslations } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer id="contact">
  <div class="foot-note">
    © {year} Vira Velmozhna — {t("footer.note")}
  </div>
</footer>
